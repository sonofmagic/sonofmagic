{
  "name": "monorepo-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "author": "ice breaker <1324318532@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/monorepo-template.git"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/monorepo-template/issues"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run --coverage.enabled",
    "test:dev": "vitest",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:fixed-versions": "node scripts/check-fixed-package-versions.mjs",
    "release": "changeset",
    "publish-packages": "pnpm check:fixed-versions && pnpm lint && turbo run typecheck build test && pnpm test:smoke && changeset publish",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "commit",
    "-------": "-----------",
    "pr:alpha": "changeset pre enter alpha",
    "pr:beta": "changeset pre enter beta",
    "pr:rc": "changeset pre enter rc",
    "pr:exit": "changeset pre exit",
    "--------": "----------------",
    "script:init": "repo init",
    "script:sync": "repo release sync-npmmirror --all",
    "script:clean": "repo workspace clean",
    "script:mirror": "repo env mirror",
    "start": "pnpm --filter @icebreakers/svg build && node index.js",
    "commitlint": "commitlint --edit",
    "test:smoke": "node scripts/smoke-built-artifacts.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@icebreakers/changelog-github": "^2.1.7",
    "@icebreakers/commitlint-config": "^4.1.5",
    "@icebreakers/eslint-config": "^8.0.12",
    "@icebreakers/monorepo": "^6.4.0",
    "@icebreakers/stylelint-config": "^5.1.5",
    "@icebreakers/svg": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "~5.1.0",
    "ci-info": "^4.4.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "defu": "^6.1.7",
    "es-toolkit": "^1.53.2",
    "eslint": "^10.14.0",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdown-table": "^3.1.0",
    "only-allow": "^1.2.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.4.0",
    "rimraf": "^6.1.4",
    "stylelint": "^17.16.0",
    "tsdown": "0.23.7",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "type-fest": "^5.10.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "~5.1.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
